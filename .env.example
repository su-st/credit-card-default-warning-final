# 複製這個檔案改名為 .env 再填入，.env 不會上傳到 GitHub
OLLAMA_URL=http://localhost:11434
TAIDE_MODEL=
LINE_CHANNEL_ACCESS_TOKEN=
# 客戶關懷只送到此測試客戶帳號，未設定即拒絕，與行員帳號分開。
LINE_TEST_CUSTOMER_ID=
# 行員摘要只送到此測試行員帳號，未設定即拒絕，不會借用客戶帳號。
LINE_TEST_STAFF_ID=
# 舊名稱僅相容客戶帳號，使用時會提醒改名，新名稱優先。
LINE_TEST_USER_ID=
# 只允許 localhost、迴圈位址、私有測試網段或保留的 .test 網域根頁，不建立公開網址。
LINE_PLATFORM_URL=http://localhost:8501/

# 預設模擬，不呼叫 LINE API，兩種訊息仍先驗證內容與對應收件者。
# 另經授權才可啟用，實際收件者由訊息類型決定，不接受呼叫端指定。
# 不同帳號才驗證分別接收，同帳號僅為「同一測試帳號模擬」。
LINE_SEND_ENABLED=false

# G2b 前填入 00_build_dev_base 印出的 M1-NS-dev19200 run_id。
PLATFORM_RUN_ID=

# F3 比較結果的 M1-NS run_id，獨立於 PLATFORM_RUN_ID，只接受完成且乾淨的 L1/L2。
PLATFORM_FAIRNESS_RUN_ID=
