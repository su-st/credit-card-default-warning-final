      {
        "cell_index": 2,
        "line": 23,
        "source": "RANDOM_STATE = 42"
      },
      {
        "cell_index": 4,
        "line": 1,
        "source": "UCI_ZIP = \"https://archive.ics.uci.edu/static/public/350/default+of+credit+card+clients.zip\""
      },
      {
        "cell_index": 4,
        "line": 3,
        "source": "def load_raw():\n    # 1) 同資料夾已有 CSV 或 XLS 就直接讀\n    if os.path.exists(\"default_of_credit_card_clients.csv\"):\n        return pd.read_csv(\"default_of_credit_card_clients.csv\")\n    if os.path.exists(\"default of credit card clients.xls\"):\n        return pd.read_excel(\"default of credit card clients.xls\", header=1)\n    # 2) 否則從 UCI 下載 zip 並解壓縮\n    urllib.request.urlretrieve(UCI_ZIP, \"credit.zip\")\n    with zipfile.ZipFile(\"credit.zip\") as z:\n        z.extractall(\"credit_raw\")\n    for root, _, files in os.walk(\"credit_raw\"):\n        for f in files:\n            if f.endswith(\".xls\"):\n                # XLS 第一列是 X1~X23 代號，第二列才是欄位名稱，所以 header=1\n                return pd.read_excel(os.path.join(root, f), header=1)\n    raise FileNotFoundError(\"找不到資料檔，請手動下載後放在同資料夾\")"
      },
      {
        "cell_index": 4,
        "line": 20,
        "source": "raw = load_raw()"
      },
      {
        "cell_index": 4,
        "line": 22,
        "source": "df = raw.rename(columns={\"PAY_0\": \"PAY_1\", \"default payment next month\": \"default\"}).drop(columns=[\"ID\"])"
      },
      {
        "cell_index": 13,
        "line": 1,
        "source": "def clean(d):\n    d = d.copy()\n    d[\"EDUCATION\"] = d[\"EDUCATION\"].replace({0: 4, 5: 4, 6: 4})\n    d[\"MARRIAGE\"] = d[\"MARRIAGE\"].replace({0: 3})\n    return d"
      },
      {
        "cell_index": 13,
        "line": 7,
        "source": "data = clean(df)"
      },
      {
        "cell_index": 13,
        "line": 18,
        "source": "train, test = train_test_split(data, test_size=0.2, random_state=RANDOM_STATE, stratify=data[\"default\"])"
      },
      {
        "cell_index": 13,
        "line": 19,
        "source": "y_train, y_test = train[\"default\"], test[\"default\"]"
      },
      {
        "cell_index": 13,
        "line": 37,
        "source": "CV = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)"
      }
